# This is Git's per-user configuration file.
[core]
	editor = code --wait
	autocrlf = false
	sshCommand = {{ if eq .chezmoi.os "windows" -}}
		C:/Windows/System32/OpenSSH/ssh.exe
	{{- else if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | contains "WSL") -}}
		ssh.exe
	{{- else -}}
		ssh
	{{- end }}

[help]
	autocorrect = 1

[alias]
	amend = commit --amend
	append = commit --amend --no-edit
	# Print origin's default branch; fall back to main before the remote HEAD is known.
	default-branch = "!f() { base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || base=origin/main; echo \"${base#origin/}\"; }; f"
	# Switch to a branch, or create it when it does not yet exist.
	ck = "!f() { git switch $1 2>/dev/null || git switch -c $1; }; f"
	cnv = commit -n -m
	# Count files changed compared to origin's default branch.
	count = "!git diff --name-only $(git default-branch)... | wc -l"
	dd = !git --no-pager diff
	discard = restore .
	last = log -1 HEAD --stat
	logf = !git log --pretty=format:"%C(magenta)%h%Creset -%C(red)%d%Creset %s %C(dim green)(%cr) [%an]" --abbrev-commit -30
	# Switch to origin's default branch.
	main = "!git switch $(git default-branch)"
	# Delete merged local branches, excluding the base branch. Usage: git purge [dev]
	purge = "!f() { base=${1:-$(git default-branch)}; git branch --merged \"$base\" | sed 's/^[* ]*//' | while IFS= read -r branch; do test \"$branch\" = \"$base\" || git branch -d \"$branch\"; done; }; f"
	st = status -sb
	# Pull and rebase from origin's default branch. Usage: git sync [dev]
	sync = "!f() { base=${1:-$(git default-branch)}; git pull origin \"$base\" --rebase; }; f"
	unstage = restore --staged
	# push and set up origin for branch
	up = !git push -u origin `git branch --show-current`
	upt = !git push origin --tags

	# save the current state of the working directory and index to the stash
	save = !git add -A && git commit -m 'SAVEPOINT'
	# undo the last commit, but keep the changes available
	undo = reset HEAD~1 --mixed
	# Interactively rebase onto origin's default branch (or a branch passed as the first argument).
	# Rebased commits receive the current author date.
	rebase-main = "!f() { base=${1:-$(git default-branch)}; git rebase -i --reset-author-date $(git merge-base HEAD $base); }; f"

[pull]
	rebase = true

[rebase]
	autoStash = true
	updateRefs = true

[fetch]
	prune = true
	pruneTags = true

[push]
	autoSetupRemote = true

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true

[diff]
	algorithm = histogram
	colorMoved = default

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[init]
	defaultBranch = main
